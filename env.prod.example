# Copy this file to ".env.prod" in the project root and fill it in.
# ".env.prod" is ignored by Git and must never be committed.
#
# Generate each key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Note: if you leave "changethis" in any key, the backend will not start (on purpose).

PROJECT_NAME="Sistema de Gestion"
FIRST_SUPERUSER=admin@tu-negocio.local
FIRST_SUPERUSER_PASSWORD=
POSTGRES_PASSWORD=
SECRET_KEY=

# Address users open the app with (no trailing slash).
# Examples: http://192.168.0.101   or   http://server-name
# If you use a port other than 80, include it: http://192.168.0.101:8000
FRONTEND_HOST=http://192.168.0.101

# --- Password recovery emails (optional) ---
# Leave them empty if you will not use emails.
# Gmail example (requires an "app password"):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS=true
#   SMTP_USER=tu-cuenta@gmail.com
#   SMTP_PASSWORD=app-password
#   EMAILS_FROM_EMAIL=tu-cuenta@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
