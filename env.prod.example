# Copiá este archivo como ".env.prod" en la raíz del proyecto y completalo.
# ".env.prod" NO se sube a Git (agregalo al .gitignore).
#
# Generar cada clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Ojo: si dejás "changethis" en alguna clave, el backend NO arranca (a propósito).

PROJECT_NAME="Sistema de Gestion"
FIRST_SUPERUSER=admin@tu-negocio.local
FIRST_SUPERUSER_PASSWORD=
POSTGRES_PASSWORD=
SECRET_KEY=

# Dirección con la que entran los usuarios (sin barra al final).
# Ejemplos: http://192.168.0.101   o   http://nombre-del-servidor
# Si usás puerto distinto del 80, incluilo: http://192.168.0.101:8000
FRONTEND_HOST=http://192.168.0.101

# --- Mails de recuperación de contraseña (opcional) ---
# Dejalos vacíos si no vas a usar mails.
# Ejemplo con Gmail (requiere "contraseña de aplicación"):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS=true
#   SMTP_USER=tu-cuenta@gmail.com
#   SMTP_PASSWORD=contraseña-de-aplicación
#   EMAILS_FROM_EMAIL=tu-cuenta@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
