# Copy this file to ".env.deploy" in the project root and fill it in.
# ".env.deploy" is ignored by Git and must never be committed.
#
# The deployment loads it explicitly, together with compose.deploy.yml:
#   docker compose -f compose.deploy.yml --env-file .env.deploy up -d
#
# Generate each key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Note: if you leave "changethis" in any key, the backend will not start (on purpose).

PROJECT_NAME="Sistema de Gestion"
# Must be a valid email address. Reserved suffixes such as ".local" are
# rejected by the validation, so use a normal domain, e.g. admin@example.com.
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=
POSTGRES_PASSWORD=
SECRET_KEY=

# Address users open the app with (no trailing slash).
# It is used to build the password recovery link, so it must include the port
# the deployment publishes (8100 in compose.deploy.yml).
# Examples: http://192.168.0.101:8100   or   http://100.127.160.19:8100
FRONTEND_HOST=http://192.168.0.101:8100

# --- Password recovery emails (optional) ---
# Leave them empty if you will not use emails.
# Gmail example (requires an "app password"):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS=true
#   SMTP_USER=tu-cuenta@gmail.com
#   SMTP_PASSWORD=app-password
#   EMAILS_FROM_EMAIL=tu-cuenta@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
