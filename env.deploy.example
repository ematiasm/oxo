# Copy this file to ".env.deploy" in the project root and fill it in.
# ".env.deploy" is ignored by Git and must never be committed, so it does not
# travel with the repository: copy it by hand to the machine that runs the
# deployment.
#
# The deployment loads it explicitly, together with compose.deploy.yml:
#   docker compose -f compose.deploy.yml --env-file .env.deploy up -d
#
# Generate each secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# token_hex keeps POSTGRES_PASSWORD alphanumeric. The password is interpolated
# into the DATABASE_URL, where characters such as "@" or "%" are ambiguous by
# URL rules; the application re-encodes them today, but avoiding them removes
# the dependency on that behaviour.

PROJECT_NAME="Sistema de Gestion"
# Must be a valid email address. Reserved suffixes such as ".local" are
# rejected by the validation, so use a normal domain, e.g. admin@example.com.
FIRST_SUPERUSER=admin@example.com
# Leave no key below empty, and never leave one as "changethis": the backend
# refuses to start. This applies to FIRST_SUPERUSER_PASSWORD,
# POSTGRES_PASSWORD and SECRET_KEY.
FIRST_SUPERUSER_PASSWORD=
POSTGRES_PASSWORD=
SECRET_KEY=

# Careful when changing POSTGRES_PASSWORD after the first deployment. The value
# is only applied when the database volume is created; an existing cluster keeps
# the old password and the backend fails with "password authentication failed".
# To change it, recreate the deployment database (this destroys its data):
#   docker compose -f compose.deploy.yml --env-file .env.deploy down
#   docker volume rm oxo-db-data
# then deploy again and rerun scripts/prestart.sh.

# Address users open the app with (no trailing slash).
# It is used to build the password recovery link, so it must include the port
# the deployment publishes (8100 in compose.deploy.yml).
# Examples: http://192.168.0.101:8100   or   http://100.127.160.19:8100
FRONTEND_HOST=http://192.168.0.101:8100

# --- Error and performance reporting (optional) ---
# Leave it empty to disable reporting. When set, it must be a full URL: a
# malformed value makes the backend fail at startup.
# Create a project at https://sentry.io and copy the DSN it gives you, e.g.
#   SENTRY_DSN=https://<public-key>@o<org>.ingest.sentry.io/<project-id>
SENTRY_DSN=

# --- Password recovery emails (optional) ---
# Leave them empty if you will not use emails.
# Gmail example (requires an "app password"):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS=true
#   SMTP_USER=tu-cuenta@gmail.com
#   SMTP_PASSWORD=app-password
#   EMAILS_FROM_EMAIL=tu-cuenta@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
